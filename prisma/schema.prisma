generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (Constants)
// ==========================================

enum EmploymentStatus {
  PROBATION
  ACTIVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

enum AdjustmentType {
  BONUS
  INCENTIVE
  OVERTIME
  DEDUCTION
  TAX
  PENALTY
}

// ==========================================
// 2. AUTHENTICATION & PERMISSIONS
// ==========================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50) // e.g., Admin, HR, Manager, Employee
  description String?          @db.VarChar(255)
  permissions RolePermission[]
  employees   Employee[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  action      String           @db.VarChar(100) // e.g., "attendance:read", "payroll:approve"
  module      String           @db.VarChar(50)  // e.g., "Payroll", "Leave"
  roles       RolePermission[]

  @@unique([action, module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  employeeId   Int      @map("employee_id")
  token        String   @unique @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(50)
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ==========================================
// 3. ORGANIZATION SETUP
// ==========================================

model Department {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  code        String       @unique @db.VarChar(20)
  description String?
  designations Designation[]
  employees   Employee[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("departments")
}

model Designation {
  id           Int         @id @default(autoincrement())
  title        String      @db.VarChar(100)
  departmentId Int         @map("department_id")
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees    Employee[]

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("designations")
}

model Shift {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(50)
  startTime    String       @map("start_time") // HH:mm format
  endTime      String       @map("end_time")   // HH:mm format
  graceMinutes Int          @default(15) @map("grace_minutes")
  employees    Employee[]

  @@map("shifts")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100)
  date        DateTime @unique @db.Date
  isOptional  Boolean  @default(false) @map("is_optional")
  description String?

  @@map("holidays")
}

// ==========================================
// 4. EMPLOYEE MANAGEMENT
// ==========================================

model Employee {
  id               Int              @id @default(autoincrement())
  employeeCode     String           @unique @map("employee_code") @db.VarChar(30)
  fullName         String           @map("full_name") @db.VarChar(150)
  email            String           @unique @db.VarChar(255)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  phone            String?          @db.VarChar(20)
  
  // Relations: Org & Roles
  roleId           Int              @map("role_id")
  role             Role             @relation(fields: [roleId], references: [id])
  
  departmentId     Int?             @map("department_id")
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId    Int?             @map("designation_id")
  designation      Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)

  shiftId          Int?             @map("shift_id")
  shift            Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Manager-Subordinate Hierarchy
  managerId        Int?             @map("manager_id")
  manager          Employee?        @relation("ManagerTeam", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers      Employee[]       @relation("ManagerTeam")

  joiningDate      DateTime?        @map("joining_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Downstream Relations
  sessions             Session[]
  attendances          Attendance[]
  attendanceCorrections AttendanceCorrectionRequest[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  assignedTasks        Task[]                @relation("TaskAssignee")
  createdTasks         Task[]                @relation("TaskCreator")
  taskComments         TaskComment[]
  notifications        Notification[]
  documents            Document[]
  salaryStructure      SalaryStructure?
  payslips             Payslip[]
  goals                Goal[]
  reviewsGiven         PerformanceReview[]   @relation("Reviewer")
  reviewsReceived      PerformanceReview[]   @relation("Reviewee")
  auditLogs            AuditLog[]

  @@map("employees")
}

// ==========================================
// 5. ATTENDANCE MANAGEMENT
// ==========================================

model Attendance {
  id               Int              @id @default(autoincrement())
  employeeId       Int              @map("employee_id")
  date             DateTime         @db.Date
  checkIn          DateTime?        @map("check_in")
  checkOut         DateTime?        @map("check_out")
  totalHours       Decimal?         @map("total_hours") @db.Decimal(5, 2)
  status           AttendanceStatus @default(PRESENT)
  isLate           Boolean          @default(false) @map("is_late")
  isEarlyDeparture Boolean          @default(false) @map("is_early_departure")

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections      AttendanceCorrectionRequest[]

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@map("attendances")
}

model AttendanceCorrectionRequest {
  id                Int           @id @default(autoincrement())
  attendanceId      Int           @map("attendance_id")
  employeeId        Int           @map("employee_id")
  requestedCheckIn  DateTime?     @map("requested_check_in")
  requestedCheckOut DateTime?     @map("requested_check_out")
  reason            String
  status            RequestStatus @default(PENDING)
  reviewedById      Int?          @map("reviewed_by_id")

  attendance        Attendance    @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("attendance_corrections")
}

// ==========================================
// 6. LEAVE MANAGEMENT
// ==========================================

model LeaveType {
  id                 Int            @id @default(autoincrement())
  name               String         @unique @db.VarChar(50) // Casual, Sick, Paid
  daysAllowedPerYear Int            @map("days_allowed_per_year")
  isPaid             Boolean        @default(true) @map("is_paid")

  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  leaveTypeId  Int       @map("leave_type_id")
  year         Int
  allocated    Decimal   @db.Decimal(5, 2)
  used         Decimal   @default(0) @db.Decimal(5, 2)

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           Int           @id @default(autoincrement())
  employeeId   Int           @map("employee_id")
  leaveTypeId  Int           @map("leave_type_id")
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  totalDays    Decimal       @map("total_days") @db.Decimal(4, 1)
  reason       String
  status       RequestStatus @default(PENDING)
  approvedById Int?          @map("approved_by_id")

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("leave_requests")
}

// ==========================================
// 7. TASK MANAGEMENT
// ==========================================

model Task {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(200)
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  deadline    DateTime?    @db.Date

  creatorId   Int          @map("creator_id")
  assigneeId  Int?         @map("assignee_id")

  creator     Employee     @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee    Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    TaskComment[]
  logs        TaskActivityLog[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("tasks")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  authorId  Int      @map("author_id")
  comment   String

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("task_comments")
}

model TaskActivityLog {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  changedBy Int      @map("changed_by")
  action    String   @db.VarChar(100) // Status updated, Deadline modified
  details   String?

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("task_activity_logs")
}

// ==========================================
// 8. NOTIFICATIONS & ANNOUNCEMENTS
// ==========================================

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int      @map("recipient_id")
  title       String   @db.VarChar(150)
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  link        String?  @db.VarChar(255) // URL to redirect
  createdAt   DateTime @default(now()) @map("created_at")

  recipient   Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  content     String
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("announcements")
}

// ==========================================
// 9. DOCUMENTS & ONBOARDING
// ==========================================

model Document {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  title       String   @db.VarChar(150) // Aadhaar, PAN, Offer Letter
  fileUrl     String   @map("file_url")
  fileType    String?  @map("file_type") @db.VarChar(50)
  isPrivate   Boolean  @default(true) @map("is_private")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("documents")
}

// ==========================================
// 10. PAYROLL MANAGEMENT
// ==========================================

model SalaryStructure {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @unique @map("employee_id")
  baseSalary   Decimal  @map("base_salary") @db.Decimal(12, 2)
  hra          Decimal  @default(0) @db.Decimal(12, 2)
  allowances   Decimal  @default(0) @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("salary_structures")
}

model PayrollRun {
  id          Int           @id @default(autoincrement())
  month       Int           // 1 to 12
  year        Int
  status      PayrollStatus @default(DRAFT)
  totalPayout Decimal       @default(0) @map("total_payout") @db.Decimal(15, 2)

  payslips    Payslip[]
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([month, year])
  @@map("payroll_runs")
}

model Payslip {
  id              Int                 @id @default(autoincrement())
  payrollRunId    Int                 @map("payroll_run_id")
  employeeId      Int                 @map("employee_id")
  grossSalary     Decimal             @map("gross_salary") @db.Decimal(12, 2)
  totalDeductions Decimal             @map("total_deductions") @db.Decimal(12, 2)
  netSalary       Decimal             @map("net_salary") @db.Decimal(12, 2)
  status          PayrollStatus       @default(DRAFT)

  payrollRun      PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  adjustments     PayrollAdjustment[]

  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

model PayrollAdjustment {
  id          Int            @id @default(autoincrement())
  payslipId   Int            @map("payslip_id")
  type        AdjustmentType
  amount      Decimal        @db.Decimal(10, 2)
  reason      String?

  payslip     Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@map("payroll_adjustments")
}

// ==========================================
// 11. PERFORMANCE MANAGEMENT
// ==========================================

model ReviewCycle {
  id        Int                 @id @default(autoincrement())
  title     String              @db.VarChar(100) // e.g. "Q1 Appraisal 2026"
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  isActive  Boolean             @default(true) @map("is_active")

  goals     Goal[]
  reviews   PerformanceReview[]

  @@map("review_cycles")
}

model Goal {
  id          Int         @id @default(autoincrement())
  employeeId  Int         @map("employee_id")
  cycleId     Int         @map("cycle_id")
  title       String      @db.VarChar(200)
  description String?
  progress    Int         @default(0) // 0 to 100%

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle       ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model PerformanceReview {
  id         Int         @id @default(autoincrement())
  cycleId    Int         @map("cycle_id")
  employeeId Int         @map("employee_id") // Reviewee
  reviewerId Int         @map("reviewer_id") // Manager / HR
  rating     Int         // 1 to 5
  feedback   String?

  cycle      ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee   Employee    @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer   Employee    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("performance_reviews")
}

// ==========================================
// 12. OPERATIONS & AUDIT LOGS
// ==========================================

model AuditLog {
  id         Int       @id @default(autoincrement())
  employeeId Int?      @map("employee_id")
  action     String    @db.VarChar(100) // e.g., "UPDATE_SALARY", "APPROVE_LEAVE"
  entity     String    @db.VarChar(100) // e.g., "SalaryStructure", "LeaveRequest"
  entityId   Int?      @map("entity_id")
  ipAddress  String?   @map("ip_address") @db.VarChar(50)
  details    Json?

  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}